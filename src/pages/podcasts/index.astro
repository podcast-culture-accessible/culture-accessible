---
import { getCollection } from "astro:content";
import EpisodeCard from "../../components/EpisodeCard.astro";
import ExternalLink from "../../components/ExternalLink.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { LINKS } from "../../lib/site";

const episodes = (await getCollection("episodes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title="Épisodes"
  description="Tous les épisodes de Culture Accessible, à écouter ou à regarder."
>
  <section class="border-b-2 border-black bg-sky">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:py-20">
      <h1 class="m-0 text-4xl sm:text-6xl">Épisodes</h1>
      <p class="mt-5 max-w-2xl text-xl">
        Chaque épisode est dédié à un enjeu de l’accessibilité culturelle, qu’on explore avec des
        invité.e.s qui militent à leur manière pour une société plus inclusive, qu’iels soient
        concerné.e.s par le handicap, professionnel.le.s de la culture, de l’accessibilité…
      </p>
      <p class="mt-4">
        <ExternalLink href={LINKS.listen}>Écouter sur toutes les plateformes</ExternalLink>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16" aria-label="Liste des épisodes">
    {episodes.length ? (
      <ul class="m-0 grid list-none gap-8 p-0 md:grid-cols-2 lg:grid-cols-3">
        {episodes.map((episode) => (
          <li>
            <EpisodeCard episode={episode} headingLevel="h2" />
          </li>
        ))}
      </ul>
    ) : (
      <p>Aucun épisode n’est publié pour le moment. Revenez bientôt.</p>
    )}
  </section>
</SiteLayout>
